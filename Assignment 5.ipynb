    "# Python Assignment 5\n",
    "import re\n",
    "string=input(\"Enter a string:\")\n",
    "if re.fullmatch(r'[a-zA-Z0-9]+',string):\n",
    "  print(\"String contains only a-z A-Z and 0-9\")\n",
    "else:\n",
    "  print(\"String contains other characters\")"
